@model IEnumerable<EasyShop.Application.DTOs.Order.OrderSummaryDto>

@{
    ViewData["Title"] = "Recent Orders (Admin)";
}

<h1 class="h3 mb-3">Manage Orders</h1>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info shadow-sm">No recent orders found.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Order #</th>
                        <th>Date</th>
                        <th>Total Amount</th>
                        <th>Items Count</th> 
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="fw-bold">#@order.Id</td>
                            <td>@order.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                            <td>@order.TotalAmount.ToString("C")</td>
                            <td>@order.TotalItems</td>
                            <td>
                                <span class="badge bg-secondary">@order.Status</span>
                            </td>
                            <td class="text-end">
                                <a asp-action="AdminDetails" asp-route-id="@order.Id" class="btn btn-sm btn-primary">Manage</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}