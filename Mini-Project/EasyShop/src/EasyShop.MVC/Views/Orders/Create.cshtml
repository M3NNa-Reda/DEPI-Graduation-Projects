@using EasyShop.Application.Services
@using EasyShop.Application.DTOs.Cart
@model CreateOrderRequestDto
@{
    ViewData["Title"] = "Checkout";
    var cart = (CartDto?)ViewBag.Cart ?? new CartDto();
}

<h1 class="h3 mb-3">Checkout</h1>

<partial name="_Alerts" />

<div class="row">
    <div class="col-lg-7">
        <form asp-action="Create" method="post" class="card shadow-sm">
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <div class="mb-3">
                    <label asp-for="AddressId" class="form-label">Delivery Address</label>
                    <select asp-for="AddressId" class="form-select" asp-items="ViewBag.Addresses">
                        <option value="">-- Select Delivery Address --</option>
                    </select>
                    <span asp-validation-for="AddressId" class="text-danger"></span>
                    <div class="form-text">
                        Need another address?
                        <a asp-controller="Addresses" asp-action="Create" asp-route-returnUrl="@Url.Action("Create", "Orders")">Add one</a>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="PaymentMethod" class="form-label">Payment Method</label>
                    <select asp-for="PaymentMethod" class="form-select" asp-items="Html.GetEnumSelectList<PaymentMethod>()">
                        <option value="">-- Select Payment Method --</option>
                    </select>
                    <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CouponCode" class="form-label">Coupon Code (Optional)</label>
                    <input asp-for="CouponCode" class="form-control" />
                    <span asp-validation-for="CouponCode" class="text-danger"></span>
                </div>
            </div>
            <div class="card-footer d-flex gap-2">
                <button type="submit" class="btn btn-primary">Place order</button>
                <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-secondary">Back to cart</a>
            </div>
        </form>
    </div>

    <div class="col-lg-5 mt-4 mt-lg-0">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold">Order summary</div>
            <ul class="list-group list-group-flush">
                @foreach (var item in cart.Items)
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <span>@item.ProductName <span class="text-muted">x @item.Quantity</span></span>
                        <span>@item.TotalPrice.ToEgp()</span>
                    </li>
                }
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted">Subtotal</span>
                    <span>@cart.Subtotal.ToEgp()</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted">Shipping</span>
                    <span>@OrderService.FlatShippingFee.ToEgp()</span>
                </li>
                <li class="list-group-item d-flex justify-content-between fw-bold">
                    <span>Total before discount</span>
                    <span>@((cart.Subtotal + OrderService.FlatShippingFee).ToEgp())</span>
                </li>
            </ul>
            <div class="card-footer small text-muted">A valid coupon code is applied when you place the order.</div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}