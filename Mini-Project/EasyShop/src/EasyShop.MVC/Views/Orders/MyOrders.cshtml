@model IEnumerable<OrderSummaryDto>

@{
    ViewData["Title"] = "My Orders";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">My Orders</h1>
    <a asp-action="Create" class="btn btn-primary">Create New Order</a>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info shadow-sm">You haven't placed any orders yet.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Order #</th>
                        <th>Date</th>
                        <th>Total Amount</th>
                        <th>Items Count</th> 
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="fw-bold">#@order.Id</td>
                            <td>@order.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                            <td>@order.TotalAmount.ToString("C")</td>
                            <td>@order.TotalItems</td>
                            <td>
                                <span class="badge bg-secondary">@order.Status</span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}