@using EasyShop.Application.DTOs.Catalog
@model IEnumerable<Product>
@{
    ViewData["Title"] = "Products";
    var brandNames = (Dictionary<int, string>)ViewBag.BrandNames;
    var categoryNames = (Dictionary<int, string>)ViewBag.CategoryNames;
    var cards = (Dictionary<int, ProductCardDto>?)ViewBag.Cards ?? new Dictionary<int, ProductCardDto>();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Products</h1>
    <div class="d-flex gap-2">
        @if (!User.IsInRole(RoleNames.Admin))
        {
            <input id="productSearch" type="search" class="form-control" placeholder="Search products" aria-label="Search products" />
        }
        @if (User.IsInRole(RoleNames.Admin))
        {
            <a asp-action="Create" class="btn btn-primary">New product</a>
        }
    </div>
</div>

<partial name="_Alerts" />

@if (!Model.Any())
{
    <div class="alert alert-info">There are no products yet.</div>
}
else if (!User.IsInRole(RoleNames.Admin))
{
    <div class="row g-3">
        @foreach (var product in Model)
        {
            cards.TryGetValue(product.Id, out var card);
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3" data-product-name="@product.Name.ToLowerInvariant()">
                <a asp-action="Details" asp-route-id="@product.Id" class="text-decoration-none text-reset">
                    <div class="card product-card h-100 shadow-sm">
                        <div class="product-card__media">
                            @if (!string.IsNullOrEmpty(card?.ImageUrl))
                            {
                                <img src="@card.ImageUrl" alt="@product.Name" loading="lazy" />
                            }
                            else
                            {
                                <div class="product-card__placeholder">No image</div>
                            }
                        </div>
                        <div class="card-body d-flex flex-column">
                            <div class="small text-muted mb-1">
                                @(brandNames.GetValueOrDefault(product.BrandId) ?? "-")
                                @if (product.CategoryId != null)
                                {
                                    <span>&middot; @categoryNames.GetValueOrDefault(product.CategoryId.Value)</span>
                                }
                            </div>
                            <h2 class="h6 mb-2">@product.Name</h2>
                            <div class="mt-auto d-flex justify-content-between align-items-center">
                                @if (card?.FromPrice != null)
                                {
                                    <span class="price">From @card.FromPrice.ToEgp()</span>
                                }
                                else
                                {
                                    <span class="text-muted small">Not available</span>
                                }
                                @if (card != null && card.FromPrice != null && !card.InStock)
                                {
                                    <span class="badge bg-secondary">Out of stock</span>
                                }
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
    <p id="noSearchResults" class="text-muted text-center py-4 d-none">No product matches your search.</p>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Brand</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td>@product.Id</td>
                            <td>
                                @product.Name
                                <div class="small text-muted"><code>@product.Slug</code></div>
                            </td>
                            <td>@(brandNames.GetValueOrDefault(product.BrandId) ?? "-")</td>
                            <td>@(product.CategoryId != null ? categoryNames.GetValueOrDefault(product.CategoryId.Value) : "-")</td>
                            <td>
                                @if (product.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td>@product.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                                <a asp-controller="Variants" asp-action="Index" asp-route-productId="@product.Id" class="btn btn-sm btn-outline-secondary">Options</a>
                                <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger">Deactivate</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
