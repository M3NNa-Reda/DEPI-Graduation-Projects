@model Product
@{
    ViewData["Title"] = Model.Name;
    var variants = (IEnumerable<ProductVariant>?)ViewBag.Variants ?? Enumerable.Empty<ProductVariant>();
    var images = (IReadOnlyList<string>?)ViewBag.Images ?? Array.Empty<string>();
    var isAdmin = User.IsInRole(RoleNames.Admin);
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-action="Index">Products</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
    </ol>
</nav>

<partial name="_Alerts" />

<div class="row g-4">
    <div class="col-lg-5">
        @if (images.Count > 0)
        {
            <img id="galleryMain" class="gallery-main shadow-sm" src="@images[0]" alt="@Model.Name" />
            @if (images.Count > 1)
            {
                <div class="d-flex flex-wrap gap-2 mt-3">
                    @for (var i = 0; i < images.Count; i++)
                    {
                        <img class="gallery-thumb @(i == 0 ? "is-active" : "")" src="@images[i]" data-full="@images[i]" alt="@Model.Name, picture @(i + 1)" loading="lazy" />
                    }
                </div>
            }
        }
        else
        {
            <div class="gallery-main d-flex align-items-center justify-content-center text-muted">No image</div>
        }
    </div>

    <div class="col-lg-7">
        <div class="small text-muted mb-1">
            @(ViewBag.BrandName ?? "-")
            @if (!string.IsNullOrEmpty((string?)ViewBag.CategoryName))
            {
                <span>&middot; @ViewBag.CategoryName</span>
            }
        </div>
        <h1 class="h2 mb-3">
            @Model.Name
            @if (!Model.IsActive)
            {
                <span class="badge bg-secondary align-middle fs-6">Inactive</span>
            }
        </h1>
        <p class="text-muted">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description yet." : Model.Description)</p>

        <h2 class="h5 mt-4 mb-3">Choose an option</h2>
        @if (!variants.Any())
        {
            <p class="text-muted">This product has no purchasable options right now.</p>
        }
        else
        {
            <div class="d-grid gap-2">
                @foreach (var variant in variants)
                {
                    <div class="variant-row d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <div>
                            <div class="fw-semibold">@variant.SKU</div>
                            <div class="small">
                                @if (variant.StockQuantity > 0)
                                {
                                    <span class="text-success">In stock (@variant.StockQuantity)</span>
                                }
                                else
                                {
                                    <span class="text-muted">Out of stock</span>
                                }
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <span class="price">@variant.Price.ToEgp()</span>
                            @if (variant.StockQuantity > 0 && User.Identity?.IsAuthenticated == true)
                            {
                                <form asp-controller="Cart" asp-action="Add" method="post" class="d-flex gap-2">
                                    <input type="hidden" name="productVariantId" value="@variant.Id" />
                                    <input type="number" name="quantity" value="1" min="1" max="@variant.StockQuantity" class="form-control form-control-sm" style="width: 5rem;" aria-label="Quantity" />
                                    <button type="submit" class="btn btn-sm btn-primary text-nowrap">Add to cart</button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>

            @if (User.Identity?.IsAuthenticated != true)
            {
                <p class="mt-3 mb-0">
                    <a asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">Log in</a>
                    to add this product to your cart.
                </p>
            }
        }
    </div>
</div>

@if (isAdmin)
{
    <div class="card shadow-sm mt-4">
        <div class="card-header fw-semibold">Admin details</div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Slug</dt>
                <dd class="col-sm-9"><code>@Model.Slug</code></dd>
                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </dd>
                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
                <dt class="col-sm-3">Updated</dt>
                <dd class="col-sm-9">@(Model.UpdatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</dd>
            </dl>
        </div>
        <div class="card-footer d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
            <a asp-controller="Variants" asp-action="Index" asp-route-productId="@Model.Id" class="btn btn-outline-primary">Prices and stock</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
        </div>
    </div>
}
