@model Product
@{
    ViewData["Title"] = "Delete Product";
}

<h1 class="h3 mb-3 text-danger">Delete Product</h1>
<p class="lead">Are you sure you want to delete this product?</p>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Slug</dt>
            <dd class="col-sm-9"><code>@Model.Slug</code></dd>

            <dt class="col-sm-3">Brand</dt>
            <dd class="col-sm-9">@(ViewBag.BrandName ?? "-")</dd>

            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@(ViewBag.CategoryName ?? "-")</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
