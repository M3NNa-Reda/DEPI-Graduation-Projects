@model Product
@{
    ViewData["Title"] = "Deactivate Product";
}

<h1 class="h3 mb-3 text-danger">Deactivate Product</h1>
<p class="lead">This product and all of its variants will be hidden from customers and can no longer be ordered. Existing orders are not affected.</p>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Slug</dt>
            <dd class="col-sm-9"><code>@Model.Slug</code></dd>

            <dt class="col-sm-3">Brand</dt>
            <dd class="col-sm-9">@(ViewBag.BrandName ?? "-")</dd>

            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@(ViewBag.CategoryName ?? "-")</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
    <button type="submit" class="btn btn-danger">Deactivate</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
