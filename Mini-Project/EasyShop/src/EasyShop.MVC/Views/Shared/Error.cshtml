@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="text-center py-5">
    <h1 class="display-6 fw-semibold">Something went wrong</h1>
    <p class="text-muted mb-4">We could not complete your request. Please try again in a moment.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Reference: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to home</a>
</div>
