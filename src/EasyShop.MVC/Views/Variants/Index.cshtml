@model IReadOnlyList<ProductVariant>
@{
    var product = (Product)ViewBag.Product;
    ViewData["Title"] = "Prices and stock";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Index">Products</a></li>
        <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id">@product.Name</a></li>
        <li class="breadcrumb-item active" aria-current="page">Options</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Prices and stock</h1>
    <a asp-action="Create" asp-route-productId="@product.Id" class="btn btn-primary">New option</a>
</div>

<partial name="_Alerts" />

@if (!product.IsActive)
{
    <div class="alert alert-warning">This product is inactive, so its options are hidden from customers until you activate it.</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">This product has no options yet. Add one with a price and stock so customers can buy it.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>SKU</th>
                        <th>Price</th>
                        <th>Original price</th>
                        <th>Stock</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var variant in Model)
                    {
                        <tr>
                            <td>@variant.SKU</td>
                            <td>@variant.Price.ToEgp()</td>
                            <td>@(variant.CompareAtPrice > 0 ? variant.CompareAtPrice.ToEgp() : "-")</td>
                            <td>@variant.StockQuantity</td>
                            <td>
                                @if (variant.IsActive)
                                {
                                    <span class="badge bg-success">On sale</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Hidden</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@variant.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
