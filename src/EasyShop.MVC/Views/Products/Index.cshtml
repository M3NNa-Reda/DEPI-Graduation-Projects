@model IEnumerable<Product>
@{
    ViewData["Title"] = "Products";
    var brandNames = (Dictionary<int, string>)ViewBag.BrandNames;
    var categoryNames = (Dictionary<int, string>)ViewBag.CategoryNames;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Products</h1>
    @if (User.IsInRole(RoleNames.Admin))
    {
        <a asp-action="Create" class="btn btn-primary">+ New Product</a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">No products yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Slug</th>
                    <th>Brand</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td>@product.Id</td>
                        <td>@product.Name</td>
                        <td><code>@product.Slug</code></td>
                        <td>@(brandNames.GetValueOrDefault(product.BrandId) ?? "-")</td>
                        <td>@(product.CategoryId != null ? categoryNames.GetValueOrDefault(product.CategoryId.Value) : "-")</td>
                        <td>
                            @if (product.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>@product.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                            @if (User.IsInRole(RoleNames.Admin))
                            {
                                <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
