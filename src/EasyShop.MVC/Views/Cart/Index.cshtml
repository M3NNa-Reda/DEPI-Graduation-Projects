@using EasyShop.Application.Services
@model EasyShop.Application.DTOs.Cart.CartDto
@{
    ViewData["Title"] = "Shopping Cart";
}

<h1 class="h3 mb-3">Shopping Cart</h1>

<partial name="_Alerts" />

@if (!Model.Items.Any())
{
    <div class="alert alert-info">
        Your cart is empty. <a asp-controller="Products" asp-action="Index">Browse products</a> to add something.
    </div>
}
else
{
    <div class="card shadow-sm mb-3">
        <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Product</th>
                    <th>SKU</th>
                    <th class="text-end">Unit price</th>
                    <th style="width: 190px;">Quantity</th>
                    <th class="text-end">Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td><code>@item.VariantName</code></td>
                        <td class="text-end">@item.UnitPrice.ToEgp()</td>
                        <td>
                            <form asp-action="Update" method="post" class="d-flex gap-2">
                                <input type="hidden" name="productVariantId" value="@item.ProductVariantId" />
                                <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control form-control-sm" />
                                <button type="submit" class="btn btn-sm btn-outline-primary">Update</button>
                            </form>
                        </td>
                        <td class="text-end">@item.TotalPrice.ToEgp()</td>
                        <td class="text-end">
                            <form asp-action="Remove" method="post">
                                <input type="hidden" name="productVariantId" value="@item.ProductVariantId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-group-divider">
    <tr>
        <td colspan="4" class="text-start text-muted fw-bold">Subtotal</td>
        <td class="text-end fw-bold text-primary">@Model.Subtotal.ToEgp()</td>
        <td></td>
    </tr>
</tfoot>
        </table>
        </div>
    </div>

    <p class="text-muted small text-end">Shipping (@OrderService.FlatShippingFee.ToEgp()) and any coupon discount are added at checkout.</p>

    <div class="d-flex justify-content-between">
        <form asp-action="Clear" method="post">
            <button type="submit" class="btn btn-outline-secondary">Clear cart</button>
        </form>
        <div class="d-flex gap-2">
            <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary">Continue shopping</a>
            <a asp-controller="Orders" asp-action="Create" class="btn btn-primary">Checkout</a>
        </div>
    </div>
}
