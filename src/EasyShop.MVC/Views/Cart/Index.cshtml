@model EasyShop.Application.DTOs.Cart.CartDto
@{
    ViewData["Title"] = "Shopping Cart";
}

<h1 class="h3 mb-3">Shopping Cart</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Items.Any())
{
    <div class="alert alert-info">
        Your cart is empty. <a asp-controller="Products" asp-action="Index">Browse products</a> to add something.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead class="table-light">
                <tr>
                    <th>Product</th>
                    <th>SKU</th>
                    <th class="text-end">Unit price</th>
                    <th style="width: 190px;">Quantity</th>
                    <th class="text-end">Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td><code>@item.VariantName</code></td>
                        <td class="text-end">@item.UnitPrice.ToString("N2")</td>
                        <td>
                            <form asp-action="Update" method="post" class="d-flex gap-2">
                                <input type="hidden" name="productVariantId" value="@item.ProductVariantId" />
                                <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control form-control-sm" />
                                <button type="submit" class="btn btn-sm btn-outline-primary">Update</button>
                            </form>
                        </td>
                        <td class="text-end">@item.TotalPrice.ToString("N2")</td>
                        <td class="text-end">
                            <form asp-action="Remove" method="post">
                                <input type="hidden" name="productVariantId" value="@item.ProductVariantId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="4" class="text-end">Subtotal</th>
                    <th class="text-end">@Model.Subtotal.ToString("N2")</th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="d-flex justify-content-between">
        <form asp-action="Clear" method="post">
            <button type="submit" class="btn btn-outline-secondary">Clear cart</button>
        </form>
        <div class="d-flex gap-2">
            <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary">Continue shopping</a>
            <a asp-controller="Orders" asp-action="Create" class="btn btn-primary">Checkout</a>
        </div>
    </div>
}
