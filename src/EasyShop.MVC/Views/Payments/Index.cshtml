@model IEnumerable<Payment>
@{
    ViewData["Title"] = "Payments";
    var selected = (PaymentStatus?)ViewBag.SelectedStatus;
}
@functions {
    private static string PaymentBadge(PaymentStatus status) => status switch
    {
        PaymentStatus.Paid => "bg-success",
        PaymentStatus.Failed => "bg-danger",
        PaymentStatus.Refunded => "bg-info",
        _ => "bg-warning text-dark"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Payments</h1>
    <form asp-action="Index" method="get" class="d-flex gap-2">
        <select name="status" class="form-select form-select-sm">
            <option value="">All statuses</option>
            @foreach (var option in Enum.GetValues<PaymentStatus>())
            {
                <option value="@option" selected="@(selected == option)">@option</option>
            }
        </select>
        <button type="submit" class="btn btn-sm btn-outline-primary">Filter</button>
    </form>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">No payments found.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Order</th>
                        <th>Method</th>
                        <th class="text-end">Amount</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Paid at</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in Model)
                    {
                        <tr>
                            <td>@payment.Id</td>
                            <td>
                                <a asp-controller="Orders" asp-action="AdminDetails" asp-route-id="@payment.OrderId">#@payment.OrderId</a>
                            </td>
                            <td>@payment.PaymentMethod</td>
                            <td class="text-end">@payment.Amount.ToString("N2")</td>
                            <td><span class="badge @PaymentBadge(payment.Status)">@payment.Status</span></td>
                            <td>@payment.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@(payment.PaidAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@payment.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
