@model EasyShop.MVC.ViewModels.PaymentDetailsViewModel
@{
    ViewData["Title"] = $"Payment #{Model.Payment.Id}";
    var payment = Model.Payment;
}
@functions {
    private static string PaymentBadge(PaymentStatus status) => status switch
    {
        PaymentStatus.Paid => "bg-success",
        PaymentStatus.Failed => "bg-danger",
        PaymentStatus.Refunded => "bg-info",
        _ => "bg-warning text-dark"
    };
}

<h1 class="h3 mb-3">Payment #@payment.Id</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Order</dt>
            <dd class="col-sm-9">
                <a asp-controller="Orders" asp-action="AdminDetails" asp-route-id="@payment.OrderId">#@payment.OrderId</a>
            </dd>

            <dt class="col-sm-3">Method</dt>
            <dd class="col-sm-9">@payment.PaymentMethod</dd>

            <dt class="col-sm-3">Amount</dt>
            <dd class="col-sm-9">@payment.Amount.ToString("N2")</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9"><span class="badge @PaymentBadge(payment.Status)">@payment.Status</span></dd>

            <dt class="col-sm-3">Created</dt>
            <dd class="col-sm-9">@payment.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>

            <dt class="col-sm-3">Paid at</dt>
            <dd class="col-sm-9">@(payment.PaidAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</dd>
        </dl>
    </div>
    <div class="card-footer d-flex gap-2">
        @if (payment.Status != PaymentStatus.Paid)
        {
            <form asp-action="MarkAsPaid" asp-route-id="@payment.Id" method="post">
                <button type="submit" class="btn btn-success">Mark as paid</button>
            </form>
            @if (payment.Status != PaymentStatus.Failed)
            {
                <form asp-action="MarkAsFailed" asp-route-id="@payment.Id" method="post">
                    <button type="submit" class="btn btn-outline-danger">Mark as failed</button>
                </form>
            }
        }
        <a asp-action="Index" class="btn btn-outline-secondary ms-auto">Back to payments</a>
    </div>
</div>

<h2 class="h5 mb-2">Transactions</h2>
@if (!Model.Transactions.Any())
{
    <div class="alert alert-info">No transactions recorded yet.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Result</th>
                        <th class="text-end">Amount</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var transaction in Model.Transactions)
                    {
                        <tr>
                            <td>@transaction.Id</td>
                            <td>@transaction.Status</td>
                            <td class="text-end">@transaction.Amount.ToString("N2")</td>
                            <td>@transaction.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
