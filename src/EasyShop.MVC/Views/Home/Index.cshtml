@model HomeViewModel
@{
    ViewData["Title"] = "Home";
    var isGuest = User.Identity?.IsAuthenticated != true;
}

@if (isGuest)
{
    <section class="es-hero">
        <h1 class="display-6 mb-3">Everything you need, one cart away.</h1>
        <p class="mb-4">Browse the catalog, pick the variant you like and check out in a few steps. Create an account to start shopping.</p>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Products" asp-action="Index" class="btn btn-light">Browse products</a>
            <a asp-controller="Auth" asp-action="Register" class="btn btn-outline-light">Create an account</a>
        </div>
    </section>
}
else
{
    <div class="mb-4">
        <h1 class="h3 mb-1">@Model.Title</h1>
        <p class="text-muted mb-0">@Model.Subtitle</p>
    </div>
}

@if (!isGuest)
{
    <div class="row g-3">
        @foreach (var card in Model.Cards)
        {
            <partial name="_StatCard" model="card" />
        }
    </div>
}
