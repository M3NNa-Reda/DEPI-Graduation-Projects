@model StatCardViewModel

<div class="col-12 col-sm-6 col-lg-4">
    <div class="card shadow-sm h-100">
        <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <h2 class="h6 text-uppercase text-muted mb-0">@Model.Title</h2>
                <span class="badge bg-primary rounded-pill fs-6">@Model.Count</span>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="text-muted small flex-grow-1 mb-3">@Model.Description</p>
            }

            <a asp-controller="@Model.Controller" asp-action="@Model.Action" class="btn btn-sm btn-outline-primary align-self-start">@Model.ButtonText</a>
        </div>
    </div>
</div>
